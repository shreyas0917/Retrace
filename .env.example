# Retrace local development — copy to `.env` (never commit `.env`)
# cp .env.example .env

# Application
ENVIRONMENT=development
API_KEY=your_api_key_here
LOG_LEVEL=INFO
# Metrics: in-memory snapshot per process + durable Postgres store (see below).
#
# The console never embeds API_KEY. Operators enter it once in the login panel
# and receive a short-lived HttpOnly session cookie (see "Session auth" below).

# PostgreSQL (Compose service defaults)
POSTGRES_USER=retrace
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=retrace
DATABASE_URL=postgresql+psycopg://retrace:your_db_password_here@postgres:5432/retrace

# Chroma (Compose service)
CHROMA_HOST=chroma
CHROMA_PORT=8000

# LLM — OpenAI-compatible API
# Local Ollama (recommended for development on Docker Desktop):
MODEL_BASE_URL=http://host.docker.internal:11434/v1
MODEL_API_KEY=ollama
MODEL_NAME=llama3.2:latest
MODEL_TIMEOUT_SECONDS=120
#
# Host-process backend talking to local Ollama instead:
# MODEL_BASE_URL=http://localhost:11434/v1
#
# Cloud OpenAI-compatible provider example:
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_API_KEY=your_llm_api_key_here
# MODEL_NAME=gpt-4.1-mini

# Embeddings — PRD-locked; do not substitute silently
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# CORS / frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://frontend:80

# Session auth / abuse controls
# HMAC key for signing console session cookies. Optional: when unset it is
# derived from API_KEY. Set an independent random value in production
# (e.g. `openssl rand -hex 32`) so rotating one secret does not rotate both.
SESSION_SECRET=
# Lifetime of a console session cookie (minutes). Default 480 (8 hours).
SESSION_TTL_MINUTES=480
# Set true when the API is served over HTTPS so the cookie gets the Secure flag.
COOKIE_SECURE=false
# Per-client sliding-window rate limit for /api/v1 (keyed by API key, session or IP).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
# Tighter limit for POST /api/v1/auth/session (brute-force protection), per IP.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Maximum characters accepted in a retrieve/generate query after control-character stripping.
MAX_QUERY_CHARS=4000
# Maximum request body size in bytes (413 PAYLOAD_TOO_LARGE above this). Default 1 MiB.
MAX_REQUEST_BYTES=1048576

# Telemetry / cost / LLM resilience (v1.0)
# Durable telemetry: every counter/latency event is also written to the
# Postgres table metric_events (flushed per request). false = in-memory only.
TELEMETRY_DURABLE=true
# Per-model USD per 1M tokens; defaults to backend/configs/pricing.yaml.
# PRICING_PATH=/app/configs/pricing.yaml
# LLM retries on transport errors / HTTP 429 / 5xx only (never on timeouts).
MODEL_MAX_RETRIES=2
MODEL_RETRY_BACKOFF_SECONDS=0.5
MODEL_CONNECT_TIMEOUT_SECONDS=10
# Uvicorn worker processes (Docker). >1 makes in-memory metrics and the
# in-memory rate limiter per-process; the durable store stays shared.
UVICORN_WORKERS=1
